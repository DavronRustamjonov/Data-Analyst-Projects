              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;EU Sales&quot; then [EU_Sales] &#13;&#10;WHEN &quot;Global Sales&quot; then [Global_Sales] &#13;&#10;WHEN &quot;JP Sales&quot; then [JP_Sales] &#13;&#10;WHEN &quot;NA Sales&quot; then [NA_Sales]&#13;&#10;when &quot;Other Sales&quot; then [Other_Sales] &#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Study period' datatype='integer' name='[Calculation_1483577823637507]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Year]&gt;=[Parameters].[Parameter 2] and [Year]&lt;=[Parameters].[Parameter 3] THEN 1&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column datatype='real' name='[EU_Sales]' role='measure' type='quantitative' />
            <column datatype='real' name='[Global_Sales]' role='measure' type='quantitative' />
